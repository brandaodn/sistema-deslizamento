<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/header', { css: '/css/visualizar-mapa.css', title: 'Detalhes do evento' }) %>
<body>
    <div class="container mt-5">
        <%- include('./partials/back-button', { backUrl: '/visualizar-eventos' }) %>
        
        <h1 class="text-center mb-4">Mais detalhes desse evento:</h1>
            <%- mensagem %>

        <%- include('partials/form-accordion', { 
                headingId: 'moreDetailsHeading',
                collapseId: 'detailsEditCollapse',
                titulo: '',
                formId: 'formMaisDetalhes',
                action: '/gerarCSV',
                method: 'post',
                formPartial: '../forms/form-mais-detalhes',
                show: true,
                expanded: true,
                botaoTexto: 'Gerar CSV com dados do evento'
        }) %>

    </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>