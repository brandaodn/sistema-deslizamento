<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/header', { css: '/css/insercao.css', title: 'Curadoria de eventos' }) %>
<body>
  <div class="container mt-5">
    <%- include('./partials/back-button', { backUrl: '/Curadoria/selecao?' }) %>
    
    <h1 class="text-center mb-4"><%- dataSelecionada %></h1>
      <%- mensagem %>

    <div id="filtros" class="container mb-3">
      <h5>Filtros</h5>
      <div class="row">
        <!-- Filtro por Localidade -->
        <div class="col-md-4">
          <h4>Localidades</h4>
          <label for="filtro-localidade-pais" class="form-label">Países</label>
          <select id="filtro-localidade-pais" class="form-select">
              <option value="">Todas</option>
          </select>
          <label for="filtro-localidade-uf" class="form-label">Unidades Federativas</label>
          <select id="filtro-localidade-uf" class="form-select">
              <option value="">Todas</option>
          </select>
          <label for="filtro-localidade" class="form-label">Municípios</label>
          <select id="filtro-localidade" class="form-select">
              <option value="">Todas</option>
          </select>
        </div>

        <!-- Filtro por Tipo de Evento -->
        <div class="col-md-4">
          <label class="form-label">Tipo de Evento</label>
          <div id="filtro-tipo-evento" class="form-check">
            <!-- checkboxes gerados dinamicamente -->
          </div>
        </div>

        <!-- Filtro por Número de Mortos -->
        <div class="col-md-4">
          <label class="form-label">Número de mortos</label>
          <div class="d-flex align-items-center gap-2">
            <input type="number" id="min-mortos" class="form-control" placeholder="Mínimo">
            <input type="number" id="max-mortos" class="form-control" placeholder="Máximo">
          </div>
        </div>
      </div>
      <div class="mt-3 text-end">
        <button id="btn-aplicar-filtros" class="btn btn-primary">Aplicar filtros</button>
      </div>
    </div>

    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""/>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
      integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
      crossorigin=""></script>

    <div id="map" style="height: 500px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.2);">

    <script type="module" src="/js/Curadoria/curation-logic.js"></script>
    <script type="module">
      import { curationLogic } from '/js/Curadoria/curation-logic.js';

      const eventos = <%- JSON.stringify(evento || []) %>;
      const midias = <%- JSON.stringify(midia || []) %>;
      curationLogic(eventos, midias);
    </script>
  </div>
  <div class="mt-5">
    <h2 id="midia-title" class="text-center mb-3" style="display:none;">Mídia relacionada a esse evento:</h2>
    <div id="midia-container" class="d-flex flex-row flex-nowrap overflow-auto px-2 gap-3"></div>

    <div id="avaliacao-container" class="mt-5 text-center" style="display:none;">
      <h2 class="mb-4">Como gostaria de avaliar esse evento?</h2>

      <form id="avaliacao-form" action="/movmassa/realizar-Curadoria" method="POST">
        <input type="hidden" id="id-evento-avaliado" name="idEvento" value="">
        <input type="hidden" id="id-data_selecionada" name="dataSelecionada" value="<%= dataSelecionada %>">

        <div class="form-check mb-3 text-start">
          <input class="form-check-input" type="radio" name="avaliacao" id="avaliacaoValido" value="valido" required>
          <label class="form-check-label" for="avaliacaoValido">
            <strong>Válido e único:</strong> O evento está corretamente mapeado e ainda não está registrado no banco
          </label>
        </div>

        <div class="form-check mb-3 text-start">
          <input class="form-check-input" type="radio" name="avaliacao" id="avaliacaoRepetido" value="repetido">
          <label class="form-check-label" for="avaliacaoRepetido">
            <strong>Válido, mas repetido:</strong> O evento está corretamente listado, mas já foi registrado no banco
          </label>
        </div>

        <div class="form-check mb-3 text-start">
          <input class="form-check-input" type="radio" name="avaliacao" id="avaliacaoInvalido" value="invalido">
          <label class="form-check-label" for="avaliacaoInvalido">
            <strong>Inválido:</strong> O evento foi incorretamente registrado como evento de deslizamento de massa, foi mapeado com dados inválidos, ou não foi rejeitado como trote anteriormente
          </label>
        </div>

        <div id="transferencia-container" class="mt-4" style="display:none;">
          <h4>Selecione um evento validado para transferir as mídias:</h4>
          <div id="transferencia-opcoes" class="mt-3"></div>
        </div>

        <button type="submit" class="btn btn-primary w-100 mt-3">Enviar Avaliação</button>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    crossorigin="anonymous"></script>
</body>
</html>
