<!DOCTYPE html>
<html lang="pt-BR">
<%- include('partials/header', { css: '/css/login.css', title: 'Cadastro' }) %>
<body>
  <div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4 col-md-4">
      <h2 class="text-center mb-4">Crie sua conta</h2>

      
        <%- include('partials/error-handler') %>


      <form id="formCadastro" action="/movmassa/cadUser" method="POST">
        
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email"  id="email" name="email" class="form-control" placeholder="Digite seu email" value="<%= email %>" required>
        </div>

        
        <div class="mb-3">
          <label for="senha" class="form-label">Senha</label>
          <input type="password" id="senha" name="senha" class="form-control" placeholder="Crie uma senha" required>
        </div>

        <div class="mb-3 text-center">
          <button type="submit" class="btn btn-success w-100">Criar Conta</button>
        </div>
      </form>

      <div class="text-center">
        <p>Já tem uma conta? <a href="/movmassa/">Entre aqui</a></p>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
