<!DOCTYPE html>
<html lang="pt-br">
<%- include('partials/header', { css: '/css/insercao.css', title: 'Curadoria de eventos' }) %>
<body>
    <div class="container mt-5">
        <%- include('./partials/back-button', { backUrl: '/menu' }) %>

        <%- mensagem %>
        <h1>Visualizar eventos</h1>

        <div class="accordion" id="accordionFiltros">
            <div class="accordion-item">
            <h2 class="accordion-header" id="filterHeading">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#filtersCollapse" aria-expanded="false">
                    Filtros
                </button>
            </h2>
            <div id="filtersCollapse" class="accordion-collapse collapse" aria-labelledby="filterHeading">
                <div class="accordion-body">
                    <div class="alert alert-danger text-center" role="alert" id="alert-error-filter" hidden><p> - </p></div>
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="form-label">Localidades</h5>
                            <label for="filtro-localidade-pais" class="form-label">Países</label>
                            <select id="filtro-localidade-pais" class="form-select">
                                <option value="">Todas</option>
                            </select>
                            <label for="filtro-localidade-uf" class="form-label">Unidades Federativas</label>
                            <select id="filtro-localidade-uf" class="form-select">
                                <option value="">Todas</option>
                            </select>
                            <label for="filtro-localidade" class="form-label">Municípios</label>
                            <select id="filtro-localidade" class="form-select">
                                <option value="">Todas</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Tipo de Evento</label>
                                <div id="filtro-tipo-evento" class="form-check">
                                </div>
                        </div>

                        <br>
                        <div class="col-md-6">
                        <label class="form-label">Número de mortos</label>
                            <div class="d-flex align-items-center gap-2">
                                <input type="number" id="min-mortos" class="form-control" placeholder="Mínimo">
                                <input type="number" id="max-mortos" class="form-control" placeholder="Máximo">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Intervalo de tempo</label>
                            <div class="d-flex align-items-center gap-2">
                                <div>
                                    <label for="data-inicial" class="form-label">Data inicial</label>
                                    <input type="date" id="data-inicial" class="form-control">
                                </div>
                                <div>
                                    <label for="data-final" class="form-label">Data final</label>
                                    <input type="date" id="data-final" class="form-control">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3 text-end">
                        <button id="btn-aplicar-filtros" class="btn btn-primary">Aplicar filtros</button>
                    </div>
                </div>
                </div>
            </div>
        </div>
 
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
            integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
            crossorigin=""/>

        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
        integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
        crossorigin=""></script>

        <div id="map" style="height: 500px; border-radius: 10px; box-shadow: 0 0 10px rgba(0,0,0,0.2);">

            <script type="module" src="/js/visualizar-mapa/viewmap-logic.js"></script>
            <script type="module">
                import { viewMapLogic } from '/js/visualizar-mapa/viewmap-logic.js';

                const eventos = <%- JSON.stringify(evento || []) %>;
                const midias = <%- JSON.stringify(midia || []) %>;
                viewMapLogic(eventos, midias);
            </script>
        </div>
        <div class="mt-5">
            <form id="avaliacao-form" action="/movmassa/ver-detalhes" method="POST">
                <input type="hidden" id="id-evento-avaliado" name="idEvento" value="">

                <h2 id="midia-title" class="text-center mb-3" style="display:none;">Mídia relacionada a esse evento:</h2>
                <div id="midia-container" class="d-flex flex-row flex-nowrap overflow-auto px-2 gap-3">

                    
                </div>
                <button type="submit" id="btn-ver-detalhes" class="btn btn-primary w-100 mt-3" style="display:none;">Ver detalhes</button>
            </form>
        </div>
    </div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>