<div class="mb-3">
    <label for="tipoMidia" class="form-label">Tipo</label>
    <select class="form-control" id="tipoMidia" name="tipoMidia" required>
        <option value="" disabled selected>Selecione o tipo da mídia</option>

        <option value="Foto"> Foto </option>
        <option value="Vídeo"> Vídeo </option>
    </select>
</div>
<div class="mb-3">
    <label for="fonteMidia" class="form-label">Fonte</label>
    <select type="text" class="form-control" id="fonteMidia" name="fonteMidia" required>
        <option value="" disabled selected>Selecione a fonte da mídia</option>
        <option value="Jornal"> Jornal </option>
        <option value="Pessoal"> Pessoal </option>
    </select>
</div>
<div class="mb-3">
    <label for="dataColeta" class="form-label">Data da Coleta</label>
    <input type="date" class="form-control" id="dataColeta" name="dataColeta">
</div>
<div class="mb-3">
    <label for="urlMidia" class="form-label">URL</label>
    <input type="text" class="form-control" id="urlMidia" name="urlMidia" placeholder="Insira o URL da mídia" required>
</div>
<div class="mb-3">
    <label for="idEventoMidia" class="form-label">Evento</label>
    <select class="form-control" id="idEventoMidia" name="idEventoMidia" required>
        <option value="" disabled selected>Selecione o evento</option>
        <% evento.forEach(function(eventoItem) { %>
            <option value="<%= eventoItem.id_evento %>">
                <%
                let data = new Date(eventoItem.data_evento);
                let dia = data.getDate().toString().padStart(2, '0');
                let mes = (data.getMonth() + 1).toString().padStart(2, '0');
                let ano = data.getFullYear();
                let dataFormatada = dia + '/' + mes + '/' + ano;
                %>
                Data: <%= dataFormatada %> 
                Longitude: <%= eventoItem.coordenadas_x %> 
                Latitude: <%= eventoItem.coordenadas_y %>
            </option>
        <% }); %>
    </select>                                                             
</div>