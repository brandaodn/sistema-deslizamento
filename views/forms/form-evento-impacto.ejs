<!-- DADOS DE IMPACTOS ECONÔMICOS -->
<h3>2. Econômicos: </h3>

<div class="mb-3">
    <label for="seguroCobertura" class="form-label">Seguro Cobertura</label>
    <select class="form-control" id="seguroCobertura" name="seguroCobertura"
        <%= readonly ? 'disabled' : '' %>>
        <option value=""><%= readonly ? 'Dado não preenchido' : 'Selecione uma opção' %></option>
        <option value="true">Possui</option>
        <option value="false">Não possui</option>
    </select>
</div>

<% if (readonly) { %>
    <input type="hidden" name="seguroCobertura" value="<%= evento[0].seguro_cobertura %>">
<% } %>

<div class="mb-3">
    <label for="custoRecuperacao" class="form-label">Custo de Recuperação (R$)</label>
    <input type="number" class="form-control" id="custoRecuperacao" name="custoRecuperacao"
        placeholder="<%= readonly ? 'Dado não preenchido' : 'Ex: 10000.50' %>" step="0.01" min="0"
        <%= readonly ? 'readonly' : '' %>>
</div>

<div class="mb-3">
