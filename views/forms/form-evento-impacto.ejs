<h1>Impactos do Evento</h1>

<!--DADOS DE IMPACTOS SOCIAIS-->

<h3>1. Sociais: </h3>

<div class="mb-3">
    <label for="tempoRecuperacaoSocial" class="form-label">Tempo de Recuperação (Dias)</label>
    <input type="number" class="form-control" id="tempoRecuperacaoSocial" name="tempoRecuperacaoSocial"
        placeholder="<%= readonly ? 'Dado não preenchido' : 'Ex: 40' %>" step="1" min="0" max="2147483647"
        <%= readonly ? 'readonly' : '' %>>
</div>

<div class="mb-3">
    <label class="form-label">Serviços Essenciais Afetados</label>

    <% const servicos = [
        "saúde e assistência médica",
        "distribuição de medicamentos e saneamento básico",
        "segurança pública e defesa civil",
        "educação (em situações de calamidade pública)",
        "transporte e funerários",
        "assistência social e previdência pública"
    ]; %>

    <% servicos.forEach(s => { %>
        <div>
            <label>
                <input type="checkbox" name="servicosEssenciaisAfetados" value="<%= s %>"
                    <%= readonly ? 'disabled' : '' %>>
                <%= s %>
            </label>
        </div>
    <% }) %>
</div>

<% if (readonly) { %>
    <input type="hidden" name="servicosEssenciaisAfetados" value="<%= evento[0].servicos_essenciais_afetados %>">
<% } %>

<!-- DADOS DE IMPACTOS SOCIAIS -->
